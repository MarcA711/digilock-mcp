{
  "name": "Rust GUI",
  "image": "localhost/rust_gui:latest",
  "runArgs": [
    "--device=/dev/dri",
    "--ipc=host",
    "--userns=keep-id",
    "--group-add=keep-groups",
    "--security-opt=label=disable",
  ],
  "mounts": [
    "source=zed-server,target=/home/vscode/.zed_server,type=volume,U=true",
    "source=${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY},target=${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY},type=bind",
  ],
  "containerEnv": {
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
  },
}
