{
  "name": "Rust MCP",
  "image": "localhost/rust_mcp:latest",
  "runArgs": [
    "--ipc=host",
    "--userns=keep-id",
    "--group-add=keep-groups",
    "--security-opt=label=disable",
    "--publish=8080:8080"
  ],
  "mounts": [
    "source=zed-server,target=/home/vscode/.zed_server,type=volume,U=true",
  ],
}
